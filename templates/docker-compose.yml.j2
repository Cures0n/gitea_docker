version: '3.8'

services:
  postgres:
    image: {{ postgres_image_name | default('postgres:15-alpine') }}
    container_name: gitea-postgres
    restart: always
    environment:
      - POSTGRES_USER=${POSTGRES_USER}
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - POSTGRES_DB=${POSTGRES_DB}
      - TZ=Europe/Moscow
    volumes:
      - ./postgres:/var/lib/postgresql/data
    networks:
      - gitea-net
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER} -d ${POSTGRES_DB}"]
      interval: 10s
      timeout: 5s
      retries: 5
    user: "{{ user_uid | default('7777') }}:{{ user_gid | default('1004') }}"

  gitea:
    image: {{ gitea_image_name | default('gitea/gitea:latest-rootless') }}
    container_name: gitea-server
    restart: always
    depends_on:
      postgres:
        condition: service_healthy
    environment:
      - USER_UID={{ user_uid | default('7777') }}
      - USER_GID={{ user_gid | default('1004') }}
      - GITEA__database__DB_TYPE=postgres
      - GITEA__database__HOST=postgres:5432
      - GITEA__database__NAME=${POSTGRES_DB}
      - GITEA__database__USER=${POSTGRES_USER}
      - GITEA__database__PASSWD=${POSTGRES_PASSWORD}
      - GITEA__server__DOMAIN={{ gitea_domain | default('localhost') }}
      - GITEA__server__HTTP_PORT=3000
      - GITEA__server__ROOT_URL=http://{{ gitea_domain | default(ansible_host) }}:3000/
      - GITEA__security__INSTALL_LOCK=true
      - GITEA__security__SECRET_KEY={{ secret_key | default('') }}
      - GITEA__security__INTERNAL_TOKEN={{ internal_token | default('') }}
    volumes:
      - ./gitea:/home/gitea
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    ports:
      - "{{ http_port | default('3000') }}:3000"
      - "{{ ssh_port | default('2222') }}:2222"
    networks:
      - gitea-net
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - SETUID
      - SETGID
      - NET_BIND_SERVICE
      - SYS_CHROOT
      - DAC_OVERRIDE

networks:
  gitea-net:
    driver: bridge
