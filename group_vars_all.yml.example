---
# Переменные для деплоя Gitea
# Скопируйте этот файл в group_vars/all.yml и отредактируйте

# =============================================================================
# Безопасность - ИЗМЕНИТЕ ЭТИ ЗНАЧЕНИЯ!
# =============================================================================

# Пароль PostgreSQL (обязательно измените!)
postgres_password: "YourSuperSecurePassword123!"

# Секретный ключ для сессий Gitea (сгенерируйте случайную строку)
secret_key: "generate-a-random-secret-key-here"

# Внутренний токен Gitea (сгенерируйте случайную строку)
internal_token: "generate-a-random-internal-token-here"

# =============================================================================
# Сетевые настройки
# =============================================================================

# Домен или IP адрес сервера Gitea
gitea_domain: "git.yourdomain.com"

# =============================================================================
# Пути и директории
# =============================================================================

# Базовая директория для Gitea
gitea_base_dir: "/opt/gitea"

# Директория для Docker образов (tar файлы)
docker_images_dir: "/opt/docker-images"

# Имена tar файлов с образами (должны быть загружены на сервер)
gitea_image_tar: "gitea-rootless.tar"
postgres_image_tar: "postgres.tar"

# =============================================================================
# Пользователь и права
# =============================================================================

# Пользователь для запуска Gitea (должен совпадать с владельцем volume)
gitea_user: "dos-tech"
gitea_uid: 7777
gitea_gid: 1004

# =============================================================================
# Настройки PostgreSQL
# =============================================================================

postgres_user: "gitea"
postgres_db: "gitea"

# =============================================================================
# Дополнительные опции
# =============================================================================

# Разрешить регистрацию новых пользователей
disable_registration: false

# Требовать подтверждение email
require_email_confirmation: false

# Отключить граватары
disable_gravatar: true
